# Copy to .env and fill in. The agent process reads these.

# --- Houdini RPC bridge ---
# Must match houdini_side/start_rpc.py (default 127.0.0.1:18811).
HOUDINI_RPC_HOST=127.0.0.1
HOUDINI_RPC_PORT=18811

# --- LLM provider (multi-provider; default DeepSeek V4 Pro) ---
# EEE_LLM_PROVIDER in {deepseek, anthropic, openai}
EEE_LLM_PROVIDER=deepseek
EEE_LLM_MODEL=deepseek-v4-pro

# DeepSeek (OpenAI-compatible). Model id verified 2026-07-11.
DEEPSEEK_API_KEY=sk-your-deepseek-key
# (legacy names deepseek-chat / deepseek-reasoner are deprecated 2026/07/24 — do not use)

# Optional alternative providers (used only if EEE_LLM_PROVIDER is switched)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Tracing (Phoenix; start server via EEE Agent menu > Start Phoenix Tracing Server) ---
# EEE_TRACING=phoenix

# --- Semantic memory (ContextSeek; file-backed, persists across runs) ---
# EEE_CONTEXTSEEK=true
