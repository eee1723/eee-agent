# Copy to .env and fill in. The agent process reads these.

# --- LLM provider (default: strict DeepSeek V4 Pro) ---
# EEE_LLM_PROVIDER in {deepseek, anthropic, openai}
EEE_LLM_PROVIDER=deepseek
EEE_LLM_MODEL=deepseek-v4-pro

# DeepSeek uses the official Anthropic-compatible endpoint:
# https://api.deepseek.com/anthropic
DEEPSEEK_API_KEY=sk-your-deepseek-key
EEE_LLM_THINKING=enabled
EEE_LLM_EFFORT=max
EEE_LLM_MAX_TOKENS=8192

# Exact DeepSeek names only: deepseek-v4-pro or deepseek-v4-flash.
# deepseek-chat and deepseek-reasoner are deprecated aliases; do not use them.

# Optional standard providers, selected only by EEE_LLM_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional advisory Vision provider (disabled unless explicitly selected) ---
# Use a model from the selected provider that supports image input.
# EEE_VISION_PROVIDER=openai
# EEE_VISION_MODEL=gpt-4.1
# EEE_VISION_MAX_IMAGE_BYTES=8388608
# EEE_VISION_TIMEOUT_SECONDS=30

# --- langgraph step budget per run (default 999; lower if the agent loops)
# EEE_RECURSION_LIMIT=999

# --- Tracing (Phoenix; start server via EEE Agent menu > Start Phoenix Tracing Server) ---
# EEE_TRACING=phoenix

# --- Semantic memory (ContextSeek; file-backed, persists across runs) ---
# EEE_CONTEXTSEEK=true

# --- Advanced tunables (all optional; sane defaults — change only if needed) ---
# EEE_RUNTIME_HOME=          override the Runtime state directory (default: %LOCALAPPDATA%/EEEAgent/state)
# EEE_TRACING_PROJECT=       Phoenix project name for traces
# EEE_TRIM_READBACKS=true    stub older re-derivable read-back tool results (context_trim)
# EEE_LOOP_GUARD=true        deterministic loop guardrail (loop_guard)
# EEE_LOOP_REPEAT=3          soft steering threshold
# EEE_LOOP_HARD=5            hard stop threshold
# EEE_LOOP_WINDOW=16         sliding window of recent tool calls
# EEE_COMPACT_TOOL=          compact tool toggle
# EEE_HFS=                   Houdini install root (knowledge-base rebuild override)
# EEE_RUN_HOUDINI_KB_TESTS=true  opt in to the local-Houdini knowledge contract tests
